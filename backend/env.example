# Copy this file to backend/.env and change the values.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (also read by the postgres container) ---
POSTGRES_DB=trackly_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Docker Compose: db      Running locally: localhost
POSTGRES_HOST=db

# --- Celery / Redis ---
# Docker Compose: redis://redis:6379/0      Running locally: redis://localhost:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
